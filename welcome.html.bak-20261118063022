  <script src="audio-vault.js?v=5"></script>
  <script>
    const CONFIG = {
      // Same-origin nginx proxies: /nocodb/ for attachment files, /diecast-api/
      // for the Hotwheels table. No token ships to the browser.
      nocodbUrl: "/nocodb",
      apiBase: "/diecast-api",
      tableId: "mygbijn9x2f7xxl",
      limit: 100,
      fields: {
        title: "Title",
        category: "Category",
        image: "Gallery"
      }
    };

    const PLACEHOLDER_URL = (text) =>
      `https://placehold.co/600x800/0f0524/00f3ff?text=${encodeURIComponent(String(text || "FRESH").trim())}`;

    // Shown only if the live fetch fails, so the page never looks empty.
    const FALLBACK_CATEGORIES = [
      { name: "Hotwheels", count: 8, title: "'92 Dodge Viper RT/10" },
      { name: "Kaido", count: 2, title: "Honda Civic EF Kaido Works V2" },
      { name: "Pink Slips", count: 1, title: "Lamborghini Countach LPI 800-4" },
      { name: "Matchbox", count: 1, title: "2023 Porsche 911 Rallye" },
      { name: "Homies", count: 1, title: "Homies Set Series 14" },
      { name: "Action Figures", count: 1, title: "Freddy Krueger" }
    ];

    function escapeHtml(value) {
      return String(value ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      }[c]));
    }

    function toAbsoluteUrl(value) {
      if (!value) return null;
      const s = String(value).trim();
      if (!s) return null;
      if (/^https?:\/\//i.test(s)) return s;
      if (s.startsWith("//")) return `http:${s}`;
      return `${CONFIG.nocodbUrl}/${s.replace(/^\/+/, "")}`;
    }

    function resolveImageUrl(imgField, title) {
      try {
        let value = imgField;
        if (typeof value === "string") {
          const s = value.trim();
          if (!s) return PLACEHOLDER_URL(title);
          if (s[0] === "[" || s[0] === "{") value = JSON.parse(s);
          else return toAbsoluteUrl(s) || PLACEHOLDER_URL(title);
        }
        const item = Array.isArray(value) ? value[0] : value;
        if (!item) return PLACEHOLDER_URL(title);
        if (typeof item === "string") return toAbsoluteUrl(item) || PLACEHOLDER_URL(title);
        // Prefer the permanent path/url; signed links expire after ~an hour.
        return toAbsoluteUrl(item.url || item.path || item.signedUrl || item.signedPath) ||
               PLACEHOLDER_URL(title);
      } catch (e) {
        return PLACEHOLDER_URL(title);
      }
    }

    function resolveThumbUrl(imgField, title) {
      try {
        let value = imgField;
        if (typeof value === "string") {
          const s = value.trim();
          if (s[0] === "[" || s[0] === "{") value = JSON.parse(s);
        }
        const item = Array.isArray(value) ? value[0] : value;
        const cover = item && item.thumbnails && item.thumbnails.card_cover;
        const path = cover && (cover.path || cover.url || cover.signedPath || cover.signedUrl);
        return toAbsoluteUrl(path) || resolveImageUrl(imgField, title);
      } catch (e) {
        return resolveImageUrl(imgField, title);
      }
    }

    function groupByCategory(records) {
      const map = new Map();
      records.forEach((row) => {
        const name = String(row[CONFIG.fields.category] || "Unclassified").trim();
        const title = String(row[CONFIG.fields.title] || "").trim();
        const img = row[CONFIG.fields.image];
        const entry = map.get(name);
        if (!entry) {
          map.set(name, {
            name,
            count: 1,
            title,
            thumb: resolveThumbUrl(img, title),
            full: resolveImageUrl(img, title)
          });
        } else {
          entry.count += 1;
          // Prefer a card that actually has artwork for the cover.
          if (!entry.thumb && img) {
            entry.title = title;
            entry.thumb = resolveThumbUrl(img, title);
            entry.full = resolveImageUrl(img, title);
          }
        }
      });
      return Array.from(map.values()).sort((a, b) => (b.count - a.count) || a.name.localeCompare(b.name));
    }

    function renderCategories(groups) {
      const grid = document.getElementById("categoryGrid");
      if (!grid) return;
      grid.innerHTML = "";

      groups.forEach((g, i) => {
        const idx = String(i + 1).padStart(2, "0");
        const count = String(g.count).padStart(2, "0");
        const href = `homepage.html?category=${encodeURIComponent(g.name)}`;

        const card = document.createElement("a");
        card.href = href;
        card.className =
          "cat-card relative block aspect-[3/4] overflow-hidden border border-cyan-400/25 bg-[#0b0420] no-underline";
        card.style.animation = `floatIn 0.6s cubic-bezier(0.22,1,0.36,1) ${0.05 * i + 0.1}s both`;
        card.title = `${g.name} — ${g.count} item${g.count === 1 ? "" : "s"}`;

        card.innerHTML = `
          <img src="${escapeHtml(g.thumb)}" alt="${escapeHtml(g.title || g.name)}"
               loading="lazy" class="cat-img absolute inset-0 w-full h-full object-cover"
               onerror="this.onerror=null;this.src='${PLACEHOLDER_URL(g.name)}'" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#070212] via-[#070212]/70 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-br from-[#9d00ff]/12 via-transparent to-transparent"></div>

          <div class="relative z-10 flex h-full flex-col justify-between p-3.5 sm:p-4">
            <div class="flex items-start justify-between">
              <span class="font-mono-tech text-[9px] sm:text-[10px] tracking-[0.25em] text-cyan-300/80">${idx}</span>
              <span class="cat-chip flex items-center justify-center w-6 h-6 sm:w-7 sm:h-7 rounded-full border border-cyan-400/50 bg-[#070212]/70 text-cyan-300 text-[10px] leading-none">&#8599;</span>
            </div>

            <div>
              <div class="text-3xl sm:text-4xl font-black leading-none text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)]">${count}</div>
              <div class="mt-1.5 font-mono-tech text-[10px] sm:text-[11px] tracking-[0.18em] text-cyan-200 uppercase leading-tight drop-shadow-[0_1px_4px_rgba(0,0,0,0.95)]">${escapeHtml(g.name)}</div>
              <div class="mt-1 font-mono-tech text-[9px] text-purple-200/85 leading-tight line-clamp-1 drop-shadow-[0_1px_3px_rgba(0,0,0,0.95)]">${escapeHtml(g.title || "")}</div>
            </div>
          </div>

          <div class="cat-rule"></div>
        `;

        grid.appendChild(card);
      });

      const items = groups.reduce((n, g) => n + g.count, 0);
      const statItems = document.getElementById("statItems");
      const statCats = document.getElementById("statCats");
      const panelCount = document.getElementById("panelCount");
      if (statItems) statItems.textContent = String(items).padStart(2, "0");
      if (statCats) statCats.textContent = String(groups.length).padStart(2, "0");
      if (panelCount) panelCount.textContent = String(groups.length).padStart(2, "0");
    }

    async function loadCategories() {
      try {
        const endpoint = `${CONFIG.apiBase}/records?limit=${CONFIG.limit}`;
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 8000);

        const response = await fetch(endpoint, {
          headers: { "Accept": "application/json" },
          signal: controller.signal
        });
        clearTimeout(timeoutId);

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const data = await response.json();
        const records = data.list || data.rows || (Array.isArray(data) ? data : []);
        if (!records.length) throw new Error("Zero records returned.");

        renderCategories(groupByCategory(records));
      } catch (err) {
        console.warn("NocoDB fetch failed, showing offline categories:", err.message);
        renderCategories(
          FALLBACK_CATEGORIES.map((c) => ({
            ...c,
            thumb: PLACEHOLDER_URL(c.name),
            full: PLACEHOLDER_URL(c.name)
          }))
        );
        const box = document.getElementById("welcomeError");
        if (box) {
          box.textContent = "Live vault unreachable — showing cached category list. The catalog link still works.";
          box.classList.remove("hidden");
        }
      }
    }

    /* =========================================================
       ROAMING '80s RETRO DIECAST CAR  (same as catalog page)
       ========================================================= */
    (function initRoamingCar() {
      const canvas = document.getElementById("roamingCarCanvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");

      let width = canvas.width = window.innerWidth;
      let height = canvas.height = window.innerHeight;

      window.addEventListener("resize", () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      const car = {
        x: width * 0.72,
        y: height * 0.3,
        angle: Math.random() * Math.PI * 2,
        targetAngle: Math.random() * Math.PI * 2,
        speed: 2.0,
        turnTimer: 0,
        trail: []
      };

      function pickNewWaypointDirection() {
        const margin = 90;
        const targetX = margin + Math.random() * Math.max(100, width - margin * 2);
        const targetY = margin + Math.random() * Math.max(100, height - margin * 2);
        car.targetAngle = Math.atan2(targetY - car.y, targetX - car.x);
        car.turnTimer = 90 + Math.floor(Math.random() * 140);
      }

      function normalizeAngle(a) {
        while (a > Math.PI) a -= Math.PI * 2;
        while (a < -Math.PI) a += Math.PI * 2;
        return a;
      }

      function updateCar() {
        car.turnTimer--;
        const margin = 65;

        if (car.x < margin || car.x > width - margin || car.y < margin || car.y > height - margin) {
          const centerAngle = Math.atan2(height / 2 - car.y, width / 2 - car.x);
          car.targetAngle = centerAngle + (Math.random() - 0.5) * 0.6;
          car.turnTimer = 60;
        } else if (car.turnTimer <= 0) {
          pickNewWaypointDirection();
        }

        const diff = normalizeAngle(car.targetAngle - car.angle);
        car.angle += diff * 0.035;

        const turnSharpness = Math.abs(diff);
        const currentSpeed = car.speed * (1 - Math.min(0.35, turnSharpness * 0.4));

        car.x += Math.cos(car.angle) * currentSpeed;
        car.y += Math.sin(car.angle) * currentSpeed;

        const rearX = car.x - Math.cos(car.angle) * 16;
        const rearY = car.y - Math.sin(car.angle) * 16;
        car.trail.push({ x: rearX, y: rearY, angle: car.angle, life: 1.0 });
        if (car.trail.length > 42) car.trail.shift();

        for (let i = 0; i < car.trail.length; i++) car.trail[i].life -= 0.024;
      }

      function drawCar() {
        ctx.clearRect(0, 0, width, height);

        for (let i = 1; i < car.trail.length; i++) {
          const p0 = car.trail[i - 1];
          const p1 = car.trail[i];
          if (p1.life <= 0) continue;

          const perpX0 = -Math.sin(p0.angle) * 5.5;
          const perpY0 = Math.cos(p0.angle) * 5.5;
          const perpX1 = -Math.sin(p1.angle) * 5.5;
          const perpY1 = Math.cos(p1.angle) * 5.5;

          ctx.strokeStyle = `rgba(255, 0, 127, ${p1.life * 0.4})`;
          ctx.lineWidth = 2;

          ctx.beginPath();
          ctx.moveTo(p0.x + perpX0, p0.y + perpY0);
          ctx.lineTo(p1.x + perpX1, p1.y + perpY1);
          ctx.stroke();

          ctx.beginPath();
          ctx.moveTo(p0.x - perpX0, p0.y - perpY0);
          ctx.lineTo(p1.x - perpX1, p1.y - perpY1);
          ctx.stroke();
        }

        ctx.save();
        ctx.translate(car.x, car.y);
        ctx.rotate(car.angle);

        const beamGrad = ctx.createLinearGradient(16, 0, 75, 0);
        beamGrad.addColorStop(0, "rgba(0, 243, 255, 0.28)");
        beamGrad.addColorStop(1, "rgba(0, 243, 255, 0)");
        ctx.fillStyle = beamGrad;
        ctx.beginPath();
        ctx.moveTo(16, -6);
        ctx.lineTo(75, -22);
        ctx.lineTo(75, 22);
        ctx.lineTo(16, 6);
        ctx.closePath();
        ctx.fill();

        ctx.shadowColor = "#00f3ff";
        ctx.shadowBlur = 12;

        ctx.fillStyle = "#090318";
        ctx.fillRect(-13, -10.5, 7, 2.5);
        ctx.fillRect(6, -10.5, 7, 2.5);
        ctx.fillRect(-13, 8, 7, 2.5);
        ctx.fillRect(6, 8, 7, 2.5);

        ctx.fillStyle = "#160730";
        ctx.strokeStyle = "#00f3ff";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.rect(-17, -8.5, 34, 17);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#ff007f";
        ctx.fillRect(4, -2, 11, 4);

        ctx.fillStyle = "#00f3ff";
        ctx.beginPath();
        ctx.moveTo(2, -6.5);
        ctx.lineTo(8, -5.5);
        ctx.lineTo(8, 5.5);
        ctx.lineTo(2, 6.5);
        ctx.closePath();
        ctx.fill();

        ctx.fillStyle = "#ff007f";
        ctx.fillRect(-18, -9.5, 3, 19);

        ctx.shadowBlur = 6;
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(15.5, -7, 2, 3.5);
        ctx.fillRect(15.5, 3.5, 2, 3.5);

        ctx.shadowColor = "#ff007f";
        ctx.fillStyle = "#ff007f";
        ctx.fillRect(-17.5, -7, 1.5, 4);
        ctx.fillRect(-17.5, 3, 1.5, 4);

        ctx.restore();
      }

      function animate() {
        updateCar();
        drawCar();
        requestAnimationFrame(animate);
      }

      animate();
    })();

    /* Background sound is provided by the shared engine: audio-vault.js */

    window.addEventListener("DOMContentLoaded", () => {
      loadCategories();
    });
  </script>
