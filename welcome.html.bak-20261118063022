          <div class="font-mono-tech text-[9px] sm:text-[10px] tracking-[0.22em] text-yellow-300 mt-1.5 uppercase">Established</div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CATEGORY SECTION  (Dribbble-style "services" panel)
         ============================================================ -->
    <section id="categories" class="max-w-7xl mx-auto px-3 sm:px-8 pb-16 sm:pb-24">
      <div class="collector-hud rounded-[1.5rem] sm:rounded-[2rem] px-4 sm:px-10 py-10 sm:py-14">

        <!-- Section header -->
        <div class="text-center">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#ff007f]/45 bg-[#ff007f]/10">
            <span class="text-[#ff9ce3] text-[11px] leading-none">&#10022;</span>
