          Enter the Catalog
          <span class="text-base leading-none">&rarr;</span>
        </a>
        <a href="#categories"
           class="cyber-btn w-full sm:w-auto px-7 py-3.5 rounded-lg font-mono-tech text-xs sm:text-sm tracking-[0.22em] uppercase flex items-center justify-center gap-2 no-underline text-cyan-300">
          Browse Categories
        </a>
      </div>

      <!-- Stat strip -->
      <div class="float-in d4 mt-10 grid grid-cols-3 gap-px overflow-hidden rounded-xl border border-purple-500/25 bg-purple-500/10">
        <div class="bg-[#0a0418]/90 px-3 py-4">
          <div id="statItems" class="text-2xl sm:text-3xl font-black text-white leading-none">--</div>
          <div class="font-mono-tech text-[9px] sm:text-[10px] tracking-[0.22em] text-cyan-300 mt-1.5 uppercase">Pieces</div>
        </div>
        <div class="bg-[#0a0418]/90 px-3 py-4">
