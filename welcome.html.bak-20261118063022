        <nav class="flex items-center gap-3 sm:gap-5 font-mono-tech text-[10px] sm:text-[11px] uppercase">
          <a href="welcome.html" class="nav-link active">Home</a>
          <a href="homepage.html" class="nav-link">Catalog</a>
          <a href="#categories" class="nav-link">Categories</a>
        </nav>

        <div class="flex items-center gap-2">
          <a id="addItemBtn" href="add-item.html"
             class="cyber-btn px-3 py-2 rounded-lg text-cyan-300 font-mono-tech text-[10px] tracking-widest uppercase flex items-center gap-1.5"
             title="Add a new item to the collection">
            <span class="text-sm leading-none">+</span>
            <span class="hidden sm:inline">ADD ITEM</span>
            <span class="sm:hidden">ADD</span>
          </a>
          <!-- Background sound lives in the floating dock (bottom-left). -->
        </div>
      </div>
    </div>
  </header>

  <main class="relative z-10 flex-1">

    <!-- ============================================================
         HERO
         ============================================================ -->
    <section class="max-w-5xl mx-auto px-4 sm:px-8 pt-14 sm:pt-20 pb-10 text-center">

      <!-- Eyebrow pill -->
      <div class="float-in d1 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-cyan-400/40 bg-[#0d0524]/80 backdrop-blur-sm">
        <span class="pulse-dot inline-block w-1.5 h-1.5 rounded-full bg-[#ff007f]"></span>
        <span class="font-mono-tech text-[9px] sm:text-[10px] tracking-[0.3em] text-cyan-200 uppercase">
          The 1:64 Vault &middot; Now Open
        </span>
      </div>

      <!-- Headline -->
      <h2 class="float-in d2 chrome-text mt-6 text-[2.6rem] leading-[0.95] sm:text-6xl md:text-7xl font-black uppercase italic">
