<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FRESH COLLECTIBLES — 1:64 N MORE</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Authentic 8x8 & Arcade Bitmap Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --sega-blue: #0055ff;
            --sega-cyan: #00f0ff;
            --sega-pink: #ff0077;
            --sega-gold: #ffcc00;
            --sega-dark: #060814;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--sega-dark);
            font-family: 'Press Start 2P', monospace;
            color: #ffffff;
        }

        /* Crisp 320x224 Native Sega Canvas Upscaling */
        #cyberCanvas {
            image-rendering: -moz-crisp-edges;
            image-rendering: -webkit-crisp-edges;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }

        /* Toggleable CRT Scanlines & Aperture Grille Overlay */
        .crt-overlay {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 50;
            background: 
                linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.36) 50%),
                linear-gradient(90deg, rgba(255, 0, 0, 0.04), rgba(0, 255, 0, 0.015), rgba(0, 0, 255, 0.04));
            background-size: 100% 3px, 4px 100%;
            box-shadow: inset 0 0 70px rgba(0, 0, 0, 0.9);
            transition: opacity 0.2s steps(2);
        }

        .crt-off {
            opacity: 0 !important;
        }

        /* Hard 16/32-Bit Arcade Pixel Drop Shadows */
        .pixel-shadow {
            text-shadow: 2px 2px 0px #000000, -1px -1px 0px #000000, 1px -1px 0px #000000, -1px 1px 0px #000000;
        }

        .pixel-shadow-lg {
            text-shadow: 4px 4px 0px #000000, -2px -2px 0px #000000, 2px -2px 0px #000000, -2px 2px 0px #000000;
        }

        /* Sega 32X Chrome & Neon Bitmap Title */
        .sega-logo-top {
            background: linear-gradient(180deg, #ffffff 0%, #7ceeff 45%, #0066ff 52%, #002266 56%, #00f0ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(3px 3px 0px #000000) drop-shadow(-1px -1px 0px #000000);
        }

        .sega-logo-bottom {
            background: linear-gradient(180deg, #ffffff 0%, #ff99cc 45%, #ff0066 52%, #550022 56%, #ff4499 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(3px 3px 0px #000000) drop-shadow(-1px -1px 0px #000000);
        }

        /* Beveled 16/32-Bit Arcade HUD Frame & Buttons */
        .sega-bevel-box {
            background-color: #0b1026;
            border: 3px solid #00f0ff;
            box-shadow: 
                inset 2px 2px 0px #7ceeff,
                inset -2px -2px 0px #004488,
                3px 3px 0px #000000;
        }

        .sega-btn-pink {
            background-color: #26081c;
            border: 3px solid #ff0077;
            box-shadow: 
                inset 2px 2px 0px #ff77bb,
                inset -2px -2px 0px #770033,
                3px 3px 0px #000000;
        }

        .sega-btn-pink:hover, .sega-btn-pink:active {
            background-color: #ff0077;
            color: #ffffff;
            transform: translate(1px, 1px);
            box-shadow: inset 2px 2px 0px #ffffff, 2px 2px 0px #000000;
        }

        .sega-cta-btn {
            background: linear-gradient(180deg, #0044cc 0%, #001a66 100%);
            border: 4px solid #ffffff;
            box-shadow: 
                inset 3px 3px 0px #00f0ff,
                inset -3px -3px 0px #001133,
                0 0 0 3px #000000,
                6px 6px 0px #ff0077;
            transition: transform 0.08s steps(2);
        }

        .sega-cta-btn:hover {
            background: linear-gradient(180deg, #ff0077 0%, #880033 100%);
            box-shadow: 
                inset 3px 3px 0px #ffcc00,
                inset -3px -3px 0px #440011,
                0 0 0 3px #000000,
                6px 6px 0px #00f0ff;
            transform: scale(1.03);
        }

        .sega-cta-btn:active {
            transform: translate(3px, 3px);
            box-shadow: 0 0 0 3px #000000, 2px 2px 0px #00f0ff;
        }

        /* Stepped 8-Bit Blink Animation */
        @keyframes stepBlink {
            0%, 49% { opacity: 1; }
            50%, 100% { opacity: 0; }
        }
        .arcade-blink {
            animation: stepBlink 0.9s infinite;
        }

        /* Stepped Equalizer Bars */
        @keyframes stepEq1 { 0%, 100% { height: 4px; } 50% { height: 14px; } }
        @keyframes stepEq2 { 0%, 100% { height: 12px; } 50% { height: 4px; } }
        @keyframes stepEq3 { 0%, 100% { height: 6px; } 50% { height: 16px; } }
        @keyframes stepEq4 { 0%, 100% { height: 14px; } 50% { height: 6px; } }

        .eq-playing .eq-bar:nth-child(1) { animation: stepEq1 0.35s steps(3) infinite; }
        .eq-playing .eq-bar:nth-child(2) { animation: stepEq2 0.28s steps(3) infinite; }
        .eq-playing .eq-bar:nth-child(3) { animation: stepEq3 0.40s steps(3) infinite; }
        .eq-playing .eq-bar:nth-child(4) { animation: stepEq4 0.32s steps(3) infinite; }
        .eq-bar {
            height: 4px;
        }

        /* Custom Pixel Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #060814;
            border-left: 2px solid #00f0ff;
        }
        ::-webkit-scrollbar-thumb {
            background: #ff0077;
            border: 2px solid #ffffff;
        }
    </style>
